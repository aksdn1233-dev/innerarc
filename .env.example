NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_HTTPS_ONLY=false
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=

# 3D Space V1: keep false until staging migration/private storage/RLS/cleanup pass.
SPACE_ENABLED=false
SPACE_AI_ENABLED=false
# No default model. Supply account-accessible IDs and verified per-million token prices in USD micros.
# Up to two approved models; expected-total-cost routing selects the order, not array position.
# Required per model: id, inputMicrosPerMillion, outputMicrosPerMillion,
# cachedInputMicrosPerMillion, cacheWriteMicrosPerMillion (conservative write ceiling >= input).
# Optional tier: routine|standard|strong|astra (cold-start prior, not measured accuracy).
# Optional reasoning requires capabilityEvidence {url: official HTTPS model docs, verifiedAt: YYYY-MM-DD},
# reasoningEfforts: verified supported values, normalEffort / escalationEffort: listed value or null.
# explicitCacheControl defaults false; enable only with verified capabilityEvidence.
# Explicit mode uses no private-image cache breakpoint. Unknown billing uses the largest input rate.
# Keep [] and both flags false until account access, image/strict-schema support and pricing are verified.
SPACE_AI_MODELS_JSON=[]
SPACE_AI_MAX_INPUT_TOKENS=16000
SPACE_AI_MAX_OUTPUT_TOKENS=4096
SPACE_AI_MAX_COST_MICROS=500000
SPACE_AI_TIMEOUT_MS=40000
OPENAI_INPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
AI_MAX_OUTPUT_TOKENS=3500
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# Server-only HMAC secrets. Use separate random values of at least 32 characters.
# The app omits provenance metadata and persistent IP/account abuse counters until set.
PROVENANCE_HMAC_SECRET=
ABUSE_HASH_SECRET=

# Payments stay closed until every required value below is configured.
PAYMENTS_PROVIDER=disabled
# Fast hosted checkout: PayApp virtual account, KakaoPay, Toss Pay, card, and mobile.
PAYAPP_USER_ID=
PAYAPP_LINK_KEY=
PAYAPP_LINK_VALUE=
PAYAPP_OPEN_PAY_TYPES=card,kakaopay,tosspay,vbank,phone,rbank

# Immediate launch path before PG approval: direct business-account transfer.
# Set PAYMENTS_PROVIDER=manual_transfer and keep these values only in deployment secrets.
MANUAL_BANK_ACCOUNTS_JSON=
# Single-account fallback when MANUAL_BANK_ACCOUNTS_JSON is not used:
MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT=
MANUAL_BANK_HOLDER=
MANUAL_DEPOSIT_WINDOW_HOURS=24

# Preferred zero-upfront path: PortOne V2 with a reviewed KPN channel.
PORTONE_STORE_ID=
PORTONE_KPN_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Existing direct Toss Payments adapter remains available as a fallback.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_CUSTOMER_KEY_SALT=
TOSS_PAYMENT_METHOD_VARIANT_KEY=DEFAULT
TOSS_AGREEMENT_VARIANT_KEY=AGREEMENT
# The former Core product is temporarily retired; its legacy price key is ignored.
#
# Both price values below are OPTIONAL. Active prices come from the code catalog in
# src/core/product-prices.ts. Setting a value here asserts that the deployment agrees
# with that catalog: a value that disagrees fails checkout closed rather than charging
# the wrong amount, and leaving it empty simply uses the catalog price. Leave them
# empty unless you specifically want that assertion, so a price change cannot strand a
# deployment on a stale secret.
INNERARC_COMPREHENSIVE_PRICE_KRW=
INNERARC_PREMIUM_PDF_PRICE_KRW=
